# Build artifacts
/dist/
/build/
/.vite/
/.cache/
/coverage/

# Dependencies and package-manager caches
/node_modules/
/.pnpm-store/
.npm/
.yarn/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files and secrets. Examples remain tracked.
.env
.env.*
!.env.example
!**/.env.example
/functions/.env
/supabase/.env
/supabase/functions/.env

# Local deployment and backend CLI state
/.firebase/
/supabase/.temp/

# Editor and IDE state
/.idea/
/.vscode/
*.user
*.suo
*.swp
*~

# Release output. Keep public/downloads/installer.json tracked.
/dist/downloads/
/public/downloads/*.exe
/public/downloads/*.zip
/public/downloads/*.sha256

